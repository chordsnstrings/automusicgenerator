[Unit]
Description=The Daily Five — callback and rating receiver
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=dailyfive
WorkingDirectory=/opt/dailyfive
EnvironmentFile=/opt/dailyfive/.env
ExecStart=/opt/dailyfive/venv/bin/dailyfive serve --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

# The receiver only ever needs to read config and write the database.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/dailyfive/work

[Install]
WantedBy=multi-user.target
