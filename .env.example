# ── Suno (sunoapi.org) ────────────────────────────────────────────────────────
# The only irreplaceable dependency. Key from sunoapi.org → API Key Management.
SUNO_API_KEY=
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_MODEL=V5_5

# Public HTTPS base for callbacks. Suno POSTs here; your ratings post here too.
# Must be reachable from the internet — ngrok is fine for local testing.
PUBLIC_BASE_URL=https://songs.example.com
# Shared secret appended to callback URLs so only Suno can hit them.
WEBHOOK_SECRET=

# ── Which brain runs which role ───────────────────────────────────────────────
# Every reasoning role names a role, never a vendor. LLM_DEFAULT backs them all;
# any single role can be moved with its own override. A spec is "provider" or
# "provider:model" — providers: anthropic | minimax | openai-compatible.
#
#   LLM_DEFAULT=minimax                  run the whole roster on MiniMax
#   LLM_DEFAULT=anthropic                ...or on Claude
#   LLM_PRODUCER=anthropic               ...and keep one role on a stronger brain
#
LLM_DEFAULT=minimax

# Per-role overrides. Blank = use LLM_DEFAULT.
LLM_SCOUT=
LLM_DIRECTOR=
LLM_ANR=
LLM_LYRICIST=
LLM_CLEARANCE=
LLM_PRODUCER=
LLM_RETRO=
LLM_VIDEODIRECTOR=

# Anything else speaking the OpenAI dialect — OpenRouter, Together, vLLM, Ollama.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── Claude ────────────────────────────────────────────────────────────────────
# Only needed if some role resolves to the anthropic provider.
ANTHROPIC_API_KEY=
# Required when the key is IDENTITY-LINKED: every request is refused without it,
# including GET /v1/models — so the key cannot be used to discover its own
# workspace and this cannot be filled in at runtime. Find it in the Console URL
# for the workspace (console.anthropic.com/settings/workspaces/<id>). Leave
# blank for a classic organisation key.
ANTHROPIC_WORKSPACE_ID=
# Thinking depth, and the only cost knob here that is not the model itself.
# low | medium | high | xhigh | max. Blank uses the API default (high).
# The Lyricist is two thirds of this studio's calls; lowering effort is the
# first thing to try if the bill matters more than the lyrics.
ANTHROPIC_EFFORT=
ANTHROPIC_MODEL=claude-opus-5

# ── MiniMax ───────────────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_TEXT_MODEL=MiniMax-M3
MINIMAX_VIDEO_MODEL=MiniMax-Hailuo-2.3

# ── BytePlus ModelArk (cover art) ─────────────────────────────────────────────
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_IMAGE_MODEL=seedream-5-0-260128

# ── Where delivered audio lives ───────────────────────────────────────────────
# database : bytes as rows in Postgres, purged automatically after RETENTION_DAYS.
#            One place to look and one thing to back up; costs more per GB than
#            object storage and makes backups larger.
# spaces   : bytes in DigitalOcean Spaces with a lifecycle rule doing the same.
# local    : the filesystem — fine for a first run, not for a catalogue.
AUDIO_STORE=database
RETENTION_DAYS=30

# The cluster's disk, in GB, read off the cluster rather than guessed. Blank
# means undeclared, which /storage reports as unknown headroom. RETENTION_DAYS
# decides where the store settles — thirty days of five songs projects to about
# 8.2 GB of table data — and a managed Postgres that fills its disk goes
# read-only with the only copy of the delivered audio inside it.
DB_DISK_GB=          # GiB, read from the provider — never inferred from a plan name

# ── DigitalOcean Spaces (only when AUDIO_STORE=spaces) ────────────────────────
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_PREFIX=songs
# Set true to make each day's index.html publicly readable.
SPACES_PUBLIC_INDEX=false

# ── Free trend signal sources (Scout) ─────────────────────────────────────────
# All optional — the Scout degrades gracefully and reports which feeds it lost.
YOUTUBE_API_KEY=
LASTFM_API_KEY=
GENIUS_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=dailyfive/0.3 (by /u/yourname)
SIGNAL_REGION=US
# Apple Music RSS, Deezer charts and Google Trends RSS need no credentials.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///dailyfive.db
# Production: postgresql+psycopg://dailyfive:pw@localhost/dailyfive

# ── Run shape ─────────────────────────────────────────────────────────────────
FULL_BRIEFS=7          # full-length briefs, contesting FULL_SLOTS
FULL_SLOTS=5
# The short-form lane is off: Suno bills per generation whatever the length, so a
# 45-second cut costs what a four-minute song costs. Set both above zero to brief
# short cuts again — nothing else has to change.
SHORT_BRIEFS=0
SHORT_SLOTS=0
SHORT_DURATION_S=45    # 10–360, V5_5 only; read when SHORT_BRIEFS > 0, not SHORT_SLOTS


# The vertical short (TikTok / YouTube Shorts). VIDEO_, not SHORT_ — the
# SHORT_* keys above are the looping-song lane and mean something else.
VIDEO_CLIPS=2
VIDEO_CLIP_SECONDS=10   # MiniMax-Hailuo-2.3: 6 or 10 at 768P, 6 only at 1080P
VIDEO_RESOLUTION=768P

# One section of this many briefs a day is written in a second language —
# a rap verse, a pre-chorus, a hook. The roster is Spanish, French,
# Portuguese, Korean and Arabic, rotated evenly by date, and it is filtered
# at runtime by which scripts this image has a font for: a language that
# cannot be rendered is not briefed. 0 ships English-only days.
LANGUAGE_BRIEFS=2
# Briefs reserved each day for genres the ratings have least to say about,
# whatever the leading genre scores. Must leave at least one brief over.
GENRE_EXPLORE_BRIEFS=2
GENRE_RHYTHM_FLOOR=2
DAILY_CREDIT_CAP=800   # hard stop; the run aborts rather than overspending
WORK_DIR=./work

# Polling cadence. Suno is asynchronous and its callbacks are unreliable, so the
# run polls as well as listens. Generation takes 60-90s per job.
POLL_INTERVAL_S=20
GENERATION_TIMEOUT_S=900
WAV_TIMEOUT_S=600

# ── publishing ───────────────────────────────────────────────────────────────
# Complete the OAuth consent once in a browser, then paste the refresh token
# here. It is read only when the database has nothing stored for that platform:
# after the first refresh the token lives in oauth_tokens, because TikTok issues
# a NEW refresh token on every refresh and a value in a file cannot be rewritten.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
