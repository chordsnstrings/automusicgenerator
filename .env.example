# ── Suno (sunoapi.org) ────────────────────────────────────────────────────────
# The only irreplaceable dependency. Key from sunoapi.org → API Key Management.
SUNO_API_KEY=
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_MODEL=V5_5

# Public HTTPS base for callbacks. Suno POSTs here; your ratings post here too.
# Must be reachable from the internet — ngrok is fine for local testing.
PUBLIC_BASE_URL=https://songs.example.com
# Shared secret appended to callback URLs so only Suno can hit them.
WEBHOOK_SECRET=

# ── Claude (Scout, Director, A&R, Clearance, Producer) ────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── MiniMax (Lyricist) ────────────────────────────────────────────────────────
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_TEXT_MODEL=MiniMax-M3

# ── BytePlus ModelArk (cover art) ─────────────────────────────────────────────
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
ARK_IMAGE_MODEL=seedream-5-0-260128

# ── DigitalOcean Spaces (delivery) ────────────────────────────────────────────
SPACES_KEY=
SPACES_SECRET=
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_PREFIX=songs
# Set true to make each day's index.html publicly readable.
SPACES_PUBLIC_INDEX=false

# ── Free trend signal sources (Scout) ─────────────────────────────────────────
# All optional — the Scout degrades gracefully and reports which feeds it lost.
YOUTUBE_API_KEY=
LASTFM_API_KEY=
GENIUS_ACCESS_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=dailyfive/0.3 (by /u/yourname)
SIGNAL_REGION=US
# Apple Music RSS, Deezer charts and Google Trends RSS need no credentials.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///dailyfive.db
# Production: postgresql+psycopg://dailyfive:pw@localhost/dailyfive

# ── Run shape ─────────────────────────────────────────────────────────────────
FULL_BRIEFS=4          # full-length briefs, contesting FULL_SLOTS
FULL_SLOTS=3
SHORT_BRIEFS=3         # short-form briefs, contesting SHORT_SLOTS
SHORT_SLOTS=2
SHORT_DURATION_S=45    # 10–360, V5_5 only
DAILY_CREDIT_CAP=800   # hard stop; the run aborts rather than overspending
WORK_DIR=./work

# Polling cadence. Suno is asynchronous and its callbacks are unreliable, so the
# run polls as well as listens. Generation takes 60-90s per job.
POLL_INTERVAL_S=20
GENERATION_TIMEOUT_S=900
WAV_TIMEOUT_S=600
